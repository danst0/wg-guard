[Unit]
Description=wg-guard - Watchdog fuer die WireGuard-Verbindung
Documentation=https://github.com/danst0/wg-guard
After=NetworkManager.service network.target
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=@LIBDIR@/wg-guard/wg-guard-daemon
# Rueckfallebene: auch bei einem Absturz bleibt der Tunnel nicht unbeaufsichtigt oben.
ExecStopPost=@LIBDIR@/wg-guard/wg-guard-daemon --down-only
Restart=always
RestartSec=5
# 78 = EX_CONFIG: eine fehlerhafte Konfiguration repariert sich nicht durch
# Neustarts. Der Grund steht in der Zustandsdatei und im Journal.
RestartPreventExitStatus=78
TimeoutStopSec=45
KillSignal=SIGTERM
SyslogIdentifier=wg-guard

# Haertung: der Daemon braucht Netzadministration, sonst nichts.
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=@STATEDIR@ /run
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
